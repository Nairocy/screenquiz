<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="1dp"
        android:gravity="center">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="@color/line_hair"
                android:dashWidth="4dp"
                android:dashGap="6dp" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <rotate
            android:fromDegrees="90"
            android:pivotX="50%"
            android:pivotY="50%">
            <inset
                android:top="31.5dp"
                android:bottom="31.5dp">
                <shape android:shape="line">
                    <stroke
                        android:width="1dp"
                        android:color="@color/line_hair"
                        android:dashWidth="4dp"
                        android:dashGap="6dp" />
                </shape>
            </inset>
        </rotate>
    </item>

    <!-- 内细框 -->
    <item
        android:bottom="9dp"
        android:left="9dp"
        android:right="9dp"
        android:top="9dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/line_hair" />
        </shape>
    </item>

    <!-- 2dp 外框 -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/outline" />
        </shape>
    </item>
</layer-list>
